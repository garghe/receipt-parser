# LM Studio OpenAI-compatible endpoint (running on your machine)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Model identifier as LM Studio reports it. Visit /models in the app to see
# the exact strings your server is serving, then paste the right one here.
LMSTUDIO_MODEL=google/gemma-4-12b

# Seconds to wait for the model. Local vision models on a receipt photo are slow.
LMSTUDIO_TIMEOUT=300

# Where the SQLite file lives
DATABASE_PATH=receipts.db

# Ambiguous dates like 03/04/2025: "day" -> 3 April (UK/EU), "month" -> 4 March (US)
DATE_ORDER=day

# Longest edge (px) of the image actually sent to the model. Smaller = faster,
# but too small and small print becomes unreadable.
MAX_IMAGE_EDGE=1600
